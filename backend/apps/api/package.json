{
  "name": "@loreloom/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/ai/*.test.ts src/services/*.test.ts src/utils/__tests__/*.test.ts",
    "test:bazaar": "tsx src/scripts/test-bazaar-discovery.ts",
    "test:chaos": "tsx src/scripts/test-chaos-recovery.ts",
    "test:image": "tsx src/scripts/test-image-gen.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0",
    "@supabase/supabase-js": "^2.110.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
